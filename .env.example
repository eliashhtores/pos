# Environment variables — copy to .env and fill in production values

# Django
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=*

# PostgreSQL
POSTGRES_DB=posdb
POSTGRES_USER=posuser
POSTGRES_PASSWORD=pospassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Default admin user created on first boot (change before deploying)
DJANGO_ADMIN_USER=admin
DJANGO_ADMIN_PASSWORD=admin
DJANGO_ADMIN_EMAIL=admin@example.com

# CORS — set CORS_ALLOW_ALL_ORIGINS=True only for local development.
# In production set it to False and list explicit origins in CORS_ALLOWED_ORIGINS.
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
