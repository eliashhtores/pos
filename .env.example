# Environment variables — copy to .env and fill in production values

# Django
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL
POSTGRES_DB=posdb
POSTGRES_USER=posuser
POSTGRES_PASSWORD=pospassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS (set to False in production and list allowed origins)
CORS_ALLOW_ALL_ORIGINS=True
